{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": 1,
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "operation_id": {
      "type": "string",
      "minLength": 1
    },
    "input_snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "prepared_relpath": {
      "type": "string",
      "minLength": 1
    },
    "target_relpath": {
      "type": "string",
      "minLength": 1
    },
    "expected_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "expected_size": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "operation_id",
    "input_snapshot_sha256",
    "prepared_relpath",
    "target_relpath",
    "expected_sha256",
    "expected_size"
  ],
  "additionalProperties": false
}
