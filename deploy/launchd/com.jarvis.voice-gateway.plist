<?xml version="1.0" encoding="UTF-8"?>
<!--
  JARVIS 语音网关 launchd 模板。
  用法：把 {{REPO}} 与 {{HOME}} 换成实际路径，存到 ~/Library/LaunchAgents/ 后：
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.jarvis.voice-gateway.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jarvis.voice-gateway</string>

    <key>ProgramArguments</key>
    <array>
        <string>{{REPO}}/.venv/bin/python3</string>
        <string>{{REPO}}/voice/voice_gateway.py</string>
        <string>--token-file</string>
        <string>{{HOME}}/.jarvis/voice-gateway.token</string>
        <string>--config</string>
        <string>{{HOME}}/.jarvis/config.json</string>
        <string>--brain-key</string>
        <string>{{HOME}}/.jarvis/api.key</string>
        <string>--data-dir</string>
        <string>{{HOME}}/.jarvis/loop-data</string>
        <string>--log</string>
        <string>{{HOME}}/.jarvis/voice-gateway.log</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>{{REPO}}/voice:{{REPO}}/packaging</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>{{REPO}}</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>{{HOME}}/.jarvis/voice-gateway.log</string>
    <key>StandardErrorPath</key>
    <string>{{HOME}}/.jarvis/voice-gateway.log</string>
</dict>
</plist>
